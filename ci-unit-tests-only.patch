From 13221937bd8a653678dd2eb3af96756eae474811 Mon Sep 17 00:00:00 2001
From: Collins Ehirim <collins@users.noreply.github.com>
Date: Tue, 17 Nov 2026 14:33:12 -0500
Subject: [PATCH] CI: run only the unit tests in tests/test_*.py

Adds pytest.ini so pytest collects test_*.py only. Without it, pytest also
picks up *_test.py files (latency_test.py, broker_restart_test.py), which
will need a live broker / Azure once they are implemented and would break CI.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013eLNg42DeF78f3FZfCkW7E
---
 .github/workflows/tests.yml | 3 ++-
 pytest.ini                  | 7 +++++++
 2 files changed, 9 insertions(+), 1 deletion(-)
 create mode 100644 pytest.ini

diff --git a/.github/workflows/tests.yml b/.github/workflows/tests.yml
index a5a7876..74ec32a 100644
--- a/.github/workflows/tests.yml
+++ b/.github/workflows/tests.yml
@@ -30,7 +30,8 @@ jobs:
         run: python -m py_compile simulator/*.py
 
       - name: Run unit tests
-        run: pytest tests/ -v
+        # pytest.ini limits this to tests/test_*.py (no broker or Azure needed)
+        run: pytest -v
 
   docker-build:
     runs-on: ubuntu-latest
diff --git a/pytest.ini b/pytest.ini
new file mode 100644
index 0000000..994b9c3
--- /dev/null
+++ b/pytest.ini
@@ -0,0 +1,7 @@
+[pytest]
+# Only unit tests run by default (locally and in GitHub Actions).
+# Files named test_*.py are unit tests: fast, no broker, no Azure.
+# The *_test.py / eval_*.py scripts in tests/ (latency, broker restart, anomaly eval)
+# need a running pipeline or Azure, so they are run by hand, not by CI.
+testpaths = tests
+python_files = test_*.py
-- 
