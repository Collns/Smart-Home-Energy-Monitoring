# Secrets - never commit
.env
.env.*
!.env.example
mosquitto/config/passwd
mosquitto/config/server.key
mosquitto/private/
mosquitto/certs/*
!mosquitto/certs/.gitkeep

# Runtime data (buffers, fault log, MQTT outbox, trained models)
data/*
!data/.gitkeep
processor/anomaly/models/*
!processor/anomaly/models/.gitkeep

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# OS / editor
.DS_Store
.idea/
.vscode/

# git patches shared during development
*.patch