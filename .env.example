MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TLS=false
MQTT_CA_CERT=/certs/ca.crt
PLUG_PASSWORD=change-me-plug
PROCESSOR_USER=processor
PROCESSOR_PASSWORD=change-me-processor
# Read-only MQTT account for debugging / tests/alert_timing_test.py (optional)
MONITOR_PASSWORD=change-me-monitor
PUBLISH_INTERVAL_S=5
SPEED=1
DROP_RATE=0.01
MALFORMED_RATE=0.005
FAULT_RATE=0
FAULT_LOG=/data/injected_faults.csv
ADX_ENABLED=false
ADX_CLUSTER_URI=
ADX_DATABASE=SmartHomeEnergy
AZURE_TENANT_ID=
ADX_PROCESSOR_CLIENT_ID=
ADX_PROCESSOR_CLIENT_SECRET=
ADX_GRAFANA_CLIENT_ID=
ADX_GRAFANA_CLIENT_SECRET=
ADX_FLUSH_S=1
# Fill gaps of up to 3 missing readings. Set false for the broker-restart / Azure-outage tests.
GAP_FILL=true
BUFFER_DIR=/data
GF_ADMIN_PASSWORD=pick-something