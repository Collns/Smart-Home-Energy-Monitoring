MQTT_HOST=mosquitto
# The broker is TLS-only (listener 8883). Inside Docker the port stays 8883 even if you remap the host port.
MQTT_PORT=8883
MQTT_TLS=true
MQTT_CA_CERT=/certs/ca.crt
# One MQTT password per plug. Choose your own: the broker runs on your machine and
# scripts/create_mqtt_users.sh builds mosquitto/config/passwd from these values.
PLUG_REFRIGERATOR_PASSWORD=change-me-refrigerator
PLUG_MICROWAVE_PASSWORD=change-me-microwave
PLUG_WASHING_MACHINE_PASSWORD=change-me-washing-machine
PLUG_WATER_HEATER_PASSWORD=change-me-water-heater
PLUG_AIR_CONDITIONER_PASSWORD=change-me-air-conditioner
PLUG_TELEVISION_PASSWORD=change-me-television
PROCESSOR_USER=processor
PROCESSOR_PASSWORD=change-me-processor
# Read-only MQTT account for debugging / tests/alert_timing_test.py (optional)
MONITOR_PASSWORD=change-me-monitor
PUBLISH_INTERVAL_S=5
SPEED=1
DROP_RATE=0.01
MALFORMED_RATE=0.005
FAULT_RATE=0
FAULT_LOG=/data/injected_faults.csv
ADX_ENABLED=false
ADX_CLUSTER_URI=
ADX_DATABASE=SmartHomeEnergy
AZURE_TENANT_ID=
ADX_PROCESSOR_CLIENT_ID=
ADX_PROCESSOR_CLIENT_SECRET=
ADX_GRAFANA_CLIENT_ID=
ADX_GRAFANA_CLIENT_SECRET=
ADX_FLUSH_S=1
# Fill gaps of up to 3 missing readings. Set false for the broker-restart / Azure-outage tests.
GAP_FILL=true
BUFFER_DIR=/data
GF_ADMIN_PASSWORD=pick-something